  "vim.statusBarColors.commandlineinprogress": "",
  // 操作过程中映射，比如dH，按下d之后，在操作过程中，这种情况要单独设置H，否则无法识别，前面normal设置的不会生效
  // 放在非递归统一管理
  // "vim.operatorPendingModeKeyBindings": [],
  "vim.operatorPendingModeKeyBindingsNonRecursive": [
    {
      "before": [
        "H"
      ],
      "after": [
        "^"
      ]
    },
    {
      "before": [
        "L"
      ],
      "after": [
        "g",
        "_"
      ]
    },
    // 删除包括{}的整段
    {
      "before": [
        "a",
        "i"
      ],
      "after": [
        "a",
        "I"
      ]
    },
    {
      "before": [
        "f"
      ],
      "after": [
        "z"
      ]
    },
    {
      "before": [
        "F"
      ],
      "after": [
        "Z"
      ]
    }
  ],
  // == normal模式 -> 放在非递归，统一管理
  // "vim.normalModeKeyBindings": [],
  // == visual模式
  // "vim.visualModeKeyBindings": [],
  // == normal非递归 禁止反复映射 递归的意思是 比如定义一个命令dd 输出 jddk,当指令到after中的jdd时,会递归, 通常after里面包含before里面的按键配置在这里
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      // 选中一个对象/数组 (光标必须在第一行)
      "before": [
        "<leader>",
        "s"
      ],
      "after": [
        "V",
        "$",
        "%"
      ]
    },
    // -- 文件目录相关操作
    // 重命名函数、变量名
    {
      "before": [
        "<leader>",
        "r",
        "n"
      ],
      "commands": [
        "editor.action.rename"
      ]
    },
    // 光标在函数名行删除整个函数
    {
      "before": [
        "<leader>",
        "d",
        "f"
      ],
      "after": [
        "V",
        "$",
        "%",
        "d"
      ]
    },
    {
      // 全部展开
      "before": [
        "<leader>",
        "<leader>",
        "["
      ],
      "commands": [
        {
          "command": "editor.foldAll"
        }
      ]
    },
    {
      // 全部展开
      "before": [
        "<leader>",
        "<leader>",
        "]"
      ],
      "commands": [
        {
          "command": "editor.unfoldAll"
        }
      ]
    },
    {
      "before": [
        "H"
      ],
      "after": [
        "^"
      ]
    },
    {
      "before": [
        "L"
      ],
      "after": [
        "g",
        "_"
      ]
    },
    {
      "before": [
        "J"
      ],
      "after": [
        "5",
        "j"
      ]
    },
    {
      "before": [
        "K"
      ],
      "after": [
        "5",
        "k"
      ]
    },
    {
      "before": [
        "'"
      ],
      "after": [
        "`"
      ]
    },
    {
      "before": [
        "s"
      ],
      "after": [
        "c",
        "l"
      ]
    },
    {
      "before": [
        "S"
      ],
      "after": [
        "^",
        "C"
      ]
    }
  ],
  // == visual非递归
  //
  "vim.visualModeKeyBindingsNonRecursive": [
    {
      "before": [
        "H"
      ],
      "after": [
        "^"
      ]
    },
    {
      "before": [
        "L"
      ],
      "after": [
        "g",
        "_"
      ]
    },
    {
      "before": [
        "J"
      ],
      "after": [
        "5",
        "j"
      ]
    },
    {
      "before": [
        "K"
      ],
      "after": [
        "5",
        "k"
      ]
    },
    // --turbo console log
    // 添加log
    {
      "before": [
        "<leader>",
        "t",
        "t"
      ],
      "commands": [
        "turboConsoleLog.displayLogMessage"
      ]
    },
    // 选中包括{}的整段，vii{}内整段
    // vim-indent-object插件，选中对象，比如{},[]内外的内容
    // 常用：vai,vii选择内外即可，ai不包括最下面一行，下面改了一下
    {
      "before": [
        "a",
        "i"
      ],
      "after": [
        "a",
        "I"
      ]
    },
    // 提取函数
    {
      "before": [
        "<Leader>",
        "r",
        "f"
      ],
      "commands": [
        {
          "command": "editor.action.refactor",
          "args": {
            "kind": "refactor.extract.function"
          }
        }
      ]
    },
    // 重构手法： 提取变量
    {
      "before": [
        "<Leader>",
        "r",
        "v"
      ],
      "commands": [
        "abracadabra.extract"
      ]
    }
